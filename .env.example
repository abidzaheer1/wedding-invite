# Copy to .env.local and fill in. See README → "Saving RSVPs to Google Forms / Google Sheets".

# --- Option A: Google Form (its linked Sheet collects the responses) ---
# viewform / formResponse link or bare form id — normalised automatically
GOOGLE_FORM_ACTION_URL=
# entry ids from the form's "Get pre-filled link" URL (with or without the "entry." prefix)
GOOGLE_FORM_ENTRY_NAME=
GOOGLE_FORM_ENTRY_PHONE=
GOOGLE_FORM_ENTRY_GUESTS=
GOOGLE_FORM_ENTRY_ATTENDING=
GOOGLE_FORM_ENTRY_MESSAGE=

# --- Option B: Google Apps Script web app that appends rows to a Sheet ---
GOOGLE_SHEETS_WEBAPP_URL=
